# ============================================
# THE MAN & TRUCK — Environment Variables
# ============================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to git!

# --------------------------------------------
# DATABASE (PostgreSQL via Prisma)
# --------------------------------------------
# Get a free DB at: https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@localhost:5432/themanandtruck"

# --------------------------------------------
# NEXTAUTH (Authentication)
# --------------------------------------------
# Generate secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-here"

# --------------------------------------------
# GOOGLE (OAuth + Maps)
# --------------------------------------------
# OAuth: https://console.cloud.google.com/apis/credentials
# Maps: https://console.cloud.google.com/google/maps-apis
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# --------------------------------------------
# STRIPE (Payments + Driver Payouts)
# --------------------------------------------
# https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# --------------------------------------------
# OPENAI (AI Pricing + Matching)
# --------------------------------------------
# https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."

# --------------------------------------------
# PUSHER (Real-time job updates)
# --------------------------------------------
# https://dashboard.pusher.com
PUSHER_APP_ID=""
PUSHER_KEY=""
PUSHER_SECRET=""
PUSHER_CLUSTER="us2"
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# --------------------------------------------
# CLOUDINARY (Driver document uploads)
# --------------------------------------------
# https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --------------------------------------------
# RESEND (Transactional email)
# --------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY="re_..."
EMAIL_FROM="noreply@themanandtruck.com"

# --------------------------------------------
# TWILIO (SMS notifications)
# --------------------------------------------
# https://console.twilio.com
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER="+1..."

# --------------------------------------------
# APP CONFIG
# --------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="The Man & Truck"
PLATFORM_FEE_PERCENT="20"
